# ──────────────────────────────────────────────────────────────────────
# o8 — environment variable reference
# ──────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is OPTIONAL — o8 boots without any of these set, but
# specific features are gated on specific vars. Sections are grouped
# by what they unlock.
#
# Paths: `~` is expanded at runtime. No personal paths in defaults.
#
# Precedence:
#   1. process.env (set by your shell)
#   2. `.env.local` (gitignored, personal overrides)
#   3. `.env` (gitignored, shared local defaults)
#   4. built-in defaults in source
#
# ──────────────────────────────────────────────────────────────────────

# ─── Core — where o8 stores state ─────────────────────────────────────

# Override the data directory (default: ~/.o8/). SQLite, directives,
# chat history, and the api-port file all live here. O8_DATA_DIR takes
# precedence; CORTEX_IDE_DATA_DIR is the legacy alias.
# O8_DATA_DIR=~/.o8
# CORTEX_IDE_DATA_DIR=~/.o8

# Explicit DB path override (default: <data dir>/cortex-ide.db).
# CORTEX_IDE_DB_PATH=

# Repo root for env-key detection — defaults to process.cwd(). Only
# override if you're running the Next server outside the repo checkout.
# CORTEX_IDE_REPO_ROOT=

# Port the Next.js backend listens on. The Tauri sidecar uses the o8
# production API block 47100-47104 (default 47100) and writes the choice
# to ~/.o8/api-port. Dev sidecars use 47120-47124 (default 47120).
# Set this only for dev when you want a fixed port.
# PORT=47100
# O8_API_PORT=47100

# WebSocket server port. Production block: 47105-47109 (default 47105).
# Dev block: 47125-47129 (default 47125). Ports 47110/47111 are reserved.
# WS_PORT=47105
# O8_WS_PORT=47105

# Sidecar-exported local identity. If unset, o8 reads ~/.o8/instance-id and
# ~/.o8/boot-id, creating them for sidecar-free dev mode when absent.
# O8_INSTANCE_ID=
# O8_BOOT_ID=

# JWT signing secret for v2 auth routes. Generate with `openssl rand -hex 32`.
# A random value is persisted to ~/.o8/.jwt-secret on first run if this
# is unset.
# CORTEX_IDE_JWT_SECRET=

# ─── LLM providers ────────────────────────────────────────────────────

# At least one is needed for the Assistant chat and tool use.
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Orchestrator Chat mode. Vercel AI Gateway fronts the free tier and BYOK
# requests; Helicone receives per-user metering headers. Clerk gates the API.
# VERCEL_AI_GATEWAY_API_KEY=
# HELICONE_API_KEY=
# Clerk auth — "Sign in with GitHub". The publishable key is app-wide + public
# and is BAKED INTO THE BUILD (the client needs the NEXT_PUBLIC_ name). The
# secret key lives ONLY on o8-site/Vercel (it mints the sign-in token) — never
# ship it in the desktop app.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=   # o8-site / Vercel only
# NEXT_PUBLIC_O8_SIGN_IN_URL=https://o8.run/desktop/sign-in

# Brave Search — optional, used by the search_web tool if set.
# BRAVE_SEARCH_API_KEY=

# ─── Engineering Brain (Cortex Q&A) ───────────────────────────────────

# Class A composer routing: auto | haiku-cli | sonnet-cli | fastest.
# 'fastest' leads with OpenRouter flash-lite (~1-3s, pennies, daily-capped).
# O8_CLASS_A_COMPOSER=

# Hard daily ceiling for the Brain's OpenRouter spend (USD). Fail-open
# guardrail: when the ledger shows >= this much spent today, the OpenRouter
# tier is skipped and the free/subscription tiers carry the question.
# O8_QA_OPENROUTER_DAILY_CAP_USD=0.50

# Workers use the Brain: off | auto | all. auto (default) injects `o8 ask`
# instructions only for non-frontier worker runtimes (tier in
# runtime-capabilities.ts); per-packet useBrain overrides either way.
# O8_WORKERS_USE_BRAIN=auto

# Local Brain inference (opt-in). The base URL is the local OpenAI-compatible
# server root (Ollama default shown; no trailing /v1). A chat model enables
# free-user Brain classify/compose + dictation polish via the local endpoint
# after a cached /api/tags liveness probe succeeds. Empty = cloud/managed path.
# O8_LOCAL_INFERENCE_BASE_URL=http://localhost:11434
# O8_LOCAL_CHAT_MODEL=qwen2.5-coder:7b
# O8_LOCAL_EMBED_MODEL=nomic-embed-text

# ─── GitHub integration ───────────────────────────────────────────────

# Device-flow OAuth client ID — the PUBLIC client id (not a secret) for the
# GitHub OAuth app that powers "Connect GitHub" during onboarding. Setting it
# flips deviceFlowEnabled true in /api/panel/github-status. Create at
# https://github.com/settings/apps -> "Register new app" (enable device flow).
# For RELEASES this is baked into signed builds — set it here at build time OR
# put it in o8.release.json at the repo root (see o8.release.example.json);
# scripts/tauri-export.mjs stamps it into the packaged server (issue #1338).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_SCOPES=repo,read:org,read:user

# GitHub App credentials (optional, for repo-scoped higher rate limits).
# Without these, o8 falls back to the user's `gh` CLI auth. The private key
# is read from the fixed path ~/.o8/github-app.pem (not configurable via env).
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_API_BASE_URL=https://api.github.com

# ─── Review surface ───────────────────────────────────────────────────

# Repo slug + root for the active-review feature (mobile review inbox).
# CORTEX_IDE_REVIEW_REPO=owner/name
# CORTEX_IDE_REVIEW_REPO_ROOT=~/projects/my-repo
# CORTEX_IDE_ACTIVE_REVIEW_ISSUE=42

# ─── Core runtime overrides ───────────────────────────────────────────

# Codex and Claude Code binary overrides. These default to the shared
# well-known-directory/PATH discovery used by onboarding and dispatch.
# CODEX_BIN=~/.npm-global/bin/codex
# CLAUDE_BIN=~/.local/bin/claude
# CODEX_HOME=~/.codex
# CLAUDE_HOME=~/.claude

# Tier-2 worker sandbox (#1325, macOS only). When on, each dispatched local
# worker is wrapped with `sandbox-exec` + a generated seatbelt profile:
# deny-by-default file access, reads scoped to toolchain/system paths,
# read+write scoped to the packet worktree + repo + TMPDIR, network allowed
# (RF-1 HTTP still works), and EXPLICIT denials on ~/.o8, ~/.tauri, and the
# /tmp/tauri-mcp-o8-* webview socket so a malicious worker can't steal the
# operator's tokens. Off by default; fail-closed when on (refuses to spawn if
# the profile can't be built). Values: off (default) | on | 1 | true | yes.
# O8_WORKER_SANDBOX=off

# ─── WebSocket / realtime ─────────────────────────────────────────────

# Token used by ws-server for mobile client auth. If unset, a random
# token is written to ~/.o8/ws-token on first run.
# WS_TOKEN=

# Override where the realtime publisher connects (default: ws://127.0.0.1:47105).
# CORTEX_REALTIME_INTERNAL_ORIGIN=

# Internal Next origin for ws-server → Next proxying (default: http://127.0.0.1:47100).
# NEXT_ORIGIN=

# ─── Operator defaults ────────────────────────────────────────────────

# Dispatch and supervision defaults exposed in Settings. These override
# ~/.o8/operator-defaults.json and the built-in fallbacks.

# Max concurrent packet dispatches (default: 5). Positive integer only.
# O8_MAX_PARALLEL_DISPATCHES=5

# Overlap gate mode: 0 = advisory (default), 1 = strict.
# O8_STRICT_OVERLAP_GATE=0

# Gate the heal-bot worker in ws-server.ts: 0/1 (default: 1).
# O8_HEAL_BOT_ENABLED=1

# Inject supervisor failures back into the orchestrator chat: 0/1 (default: 0).
# O8_SUPERVISOR_AUTO_ESCALATE=0

# Default thinking effort for new orchestrator threads:
# adaptive | low | medium | high | max | xhigh (default: adaptive).
# O8_THINKING_EFFORT=adaptive

# Gate Anthropic cache_control injection in /api/v2/proxy/llm: 0/1 (default: 1).
# O8_PROMPT_CACHING=1

# Default orchestrator model for new threads. Built-in options include
# claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-sonnet-4-5,
# and claude-haiku-4-5 (default: claude-opus-4-7).
# O8_ORCHESTRATOR_MODEL=claude-opus-4-7

# ─── Entitlement / licensing ──────────────────────────────────────────

# Plan override for local testing of Pro-gated features: free | pro.
# O8_PLAN=

# License-verifier public key override (dev/testing only; the production
# key is compiled into the app).
# O8_LICENSE_PUBKEY=

# Require BYOK keys for LLM features (Q&A cascade): 0/1.
# O8_BYOK_REQUIRED=

# Show the Settings → API Keys (BYOK) tab. Default HIDDEN (2026-06-16): the
# managed-inference proxy replaces BYOK. Set to 1 to restore the manual
# key-paste surface (founder / QA / power users who ask).
# NEXT_PUBLIC_O8_SHOW_BYOK=

# ─── Experimental runtimes / dispatch ─────────────────────────────────

# Surface experimental runtime adapters in the dispatch picker: 0/1.
# O8_EXPERIMENTAL_GEMINI=
# O8_EXPERIMENTAL_OPENCODE=

# Default dispatch runtime when a packet doesn't specify one.
# O8_DEFAULT_DISPATCH_RUNTIME=codex

# ─── Tauri packaging ──────────────────────────────────────────────────

# Signals the packaged app is running and tells Next where the bundled
# MCP scripts live. These are set automatically by the Rust sidecar —
# don't set them manually unless you know what you're doing.
# O8_NODE_BIN=
# O8_BUNDLED_MCP_DIR=
# O8_BUNDLED_MCP_PATH=
# O8_TAURI_MCP_SOCKET=

# ─── Crash / error telemetry (Sentry — dormant by default) ───────────

# Sentry DSN for crash/error reporting. Only honored in PACKAGED builds
# (O8_PACKAGED_APP=1); dev runs stay silent regardless. Normally baked at
# release build from o8.release.json (`sentryDsn` key) by
# scripts/tauri-export.mjs + src-tauri/build.rs — see o8.release.example.json.
# Absent → zero behavior change, zero network.
# O8_SENTRY_DSN=

# "Crash & error reports" toggle override: 1/0 (default: 1 — but dormant
# without a DSN). The Settings toggle persists to operator-defaults.json.
# O8_CRASH_REPORTS=

# ─── Deployments (optional) ───────────────────────────────────────────

# Vercel token for the deploys panel.
# VERCEL_TOKEN=

# Public base URL (for OAuth callbacks, webhook URLs, etc.).
# CORTEX_IDE_PUBLIC_BASE_URL=https://your-o8-host.example

# ─── Build-time (read by postinstall / scripts) ───────────────────────

# Git commit SHA — set by CI, used in the About panel.
# GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_REPO_URL=https://github.com/hurttlocker/o8

# ─── Beta invites — central referral (optional) ───────────────────────
# When both are set, sharing a founding invite registers the code with the
# hosted invite service so o8.run/i/<code> can redeem it cross-machine.
# Unset = local-only invites (codes only valid on this install).
# See docs/beta-invites.md.
# O8_INVITE_SERVICE_URL=https://api.o8.run
# O8_INVITE_REGISTER_TOKEN=   # registration credential issued by the service operator

# ── Feedback: private intake, public fixes ────────────────────────────────────
# Reports (Cmd+Shift+E) carry a screenshot of the operator's whole window and
# crash traces with their repo paths in them — so INTAKE IS PRIVATE. The public
# artifact is the FIX: a commit trailer `Fixes-Report: <id>` publishes it to the
# #fixed channel, credited to the reporter's GitHub handle. Open problems rot;
# fixed ones never do.
#
# Both webhooks normally live in o8.release.json (gitignored, alongside the Sentry
# DSN) — these env vars are the override. The intake webhook was hardcoded in
# route.ts until 2026-07-13; that one is revoked. Don't put a webhook in source.
#
# Private ops channel — where reports land. Absent => the Report button errors
# loudly rather than silently swallowing a report someone took a minute to write.
# O8_FEEDBACK_WEBHOOK_URL=
# Public #fixed channel — where wins get announced. Absent => `npm run publish:fixed`
# refuses to run rather than silently dropping someone's credit.
# O8_FIXED_WEBHOOK_URL=
# Discord bot token — reads the PRIVATE intake channel back into the local report
# ledger (npm run sync:reports). Required because a user's report is recorded on
# THEIR machine, not ours: without it, a fix for someone else's bug resolves to
# "unknown report id" and is silently dropped. NEVER put this in o8.release.json —
# that file is baked into the packaged app.
# Falls back to ~/.o8/discord-bot-token (chmod 600).
# O8_DISCORD_BOT_TOKEN=
