# ──────────────────────────────────────────────────────────────────────
# o8 — environment variable reference
# ──────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is OPTIONAL — o8 boots without any of these set, but
# specific features are gated on specific vars. Sections are grouped
# by what they unlock.
#
# Paths: `~` is expanded at runtime. No personal paths in defaults.
#
# Precedence:
#   1. process.env (set by your shell)
#   2. `.env.local` (gitignored, personal overrides)
#   3. `.env` (gitignored, shared local defaults)
#   4. built-in defaults in source
#
# ──────────────────────────────────────────────────────────────────────

# ─── Core — where o8 stores state ─────────────────────────────────────

# Override the data directory (default: ~/.o8/). SQLite, directives,
# chat history, and the api-port file all live here. O8_DATA_DIR takes
# precedence; CORTEX_IDE_DATA_DIR is the legacy alias.
# O8_DATA_DIR=~/.o8
# CORTEX_IDE_DATA_DIR=~/.o8

# Explicit DB path override (default: <data dir>/cortex-ide.db).
# CORTEX_IDE_DB_PATH=

# Repo root for env-key detection — defaults to process.cwd(). Only
# override if you're running the Next server outside the repo checkout.
# CORTEX_IDE_REPO_ROOT=

# Port the Next.js backend listens on. The Tauri sidecar probes
# 3001-3050 for a free port at startup and writes the choice to
# ~/.o8/api-port. Set this only for dev when you want a fixed port.
# PORT=3001
# O8_API_PORT=3001

# WebSocket server port. Same dynamic-allocation rules as PORT.
# WS_PORT=3002
# O8_WS_PORT=3002

# JWT signing secret for v2 auth routes. Generate with `openssl rand -hex 32`.
# A random value is persisted to ~/.o8/.jwt-secret on first run if this
# is unset.
# CORTEX_IDE_JWT_SECRET=

# ─── LLM providers ────────────────────────────────────────────────────

# At least one is needed for the Assistant chat and tool use.
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Orchestrator Chat mode. Vercel AI Gateway fronts the free tier and BYOK
# requests; Helicone receives per-user metering headers. Clerk gates the API.
# VERCEL_AI_GATEWAY_API_KEY=
# HELICONE_API_KEY=
# Clerk auth — "Sign in with GitHub". The publishable key is app-wide + public
# and is BAKED INTO THE BUILD (the client needs the NEXT_PUBLIC_ name). The
# secret key lives ONLY on o8-site/Vercel (it mints the sign-in token) — never
# ship it in the desktop app.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=   # o8-site / Vercel only
# NEXT_PUBLIC_O8_SIGN_IN_URL=https://o8.run/desktop/sign-in

# Brave Search — optional, used by the search_web tool if set.
# BRAVE_SEARCH_API_KEY=

# ─── Engineering Brain (Cortex Q&A) ───────────────────────────────────

# Class A composer routing: auto | haiku-cli | sonnet-cli | fastest.
# 'fastest' leads with OpenRouter flash-lite (~1-3s, pennies, daily-capped).
# O8_CLASS_A_COMPOSER=

# Hard daily ceiling for the Brain's OpenRouter spend (USD). Fail-open
# guardrail: when the ledger shows >= this much spent today, the OpenRouter
# tier is skipped and the free/subscription tiers carry the question.
# O8_QA_OPENROUTER_DAILY_CAP_USD=0.50

# Workers use the Brain: off | auto | all. auto (default) injects `o8 ask`
# instructions only for non-frontier worker runtimes (tier in
# runtime-capabilities.ts); per-packet useBrain overrides either way.
# O8_WORKERS_USE_BRAIN=auto

# ─── GitHub integration ───────────────────────────────────────────────

# Device flow OAuth client ID (recommended for dev).
# Create at https://github.com/settings/apps -> "Register new app".
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_SCOPES=repo,read:org,read:user

# GitHub App credentials (optional, for repo-scoped higher rate limits).
# Without these, o8 falls back to the user's `gh` CLI auth. The private key
# is read from the fixed path ~/.o8/github-app.pem (not configurable via env).
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_API_BASE_URL=https://api.github.com

# ─── Review surface ───────────────────────────────────────────────────

# Repo slug + root for the active-review feature (mobile review inbox).
# CORTEX_IDE_REVIEW_REPO=owner/name
# CORTEX_IDE_REVIEW_REPO_ROOT=~/projects/my-repo
# CORTEX_IDE_ACTIVE_REVIEW_ISSUE=42

# ─── Runtime adapters (Codex + Claude Code) ───────────────────────────

# Runtime binary overrides. Both default to login-shell `which`.
# CODEX_BIN=~/.npm-global/bin/codex
# CLAUDE_BIN=~/.local/bin/claude
# CODEX_HOME=~/.codex
# CLAUDE_HOME=~/.claude

# ─── WebSocket / realtime ─────────────────────────────────────────────

# Token used by ws-server for mobile client auth. If unset, a random
# token is written to ~/.o8/ws-token on first run.
# WS_TOKEN=

# Override where the realtime publisher connects (default: ws://127.0.0.1:3002).
# CORTEX_REALTIME_INTERNAL_ORIGIN=

# Internal Next origin for ws-server → Next proxying (default: http://127.0.0.1:3001).
# NEXT_ORIGIN=

# ─── Operator defaults ────────────────────────────────────────────────

# Dispatch and supervision defaults exposed in Settings. These override
# ~/.o8/operator-defaults.json and the built-in fallbacks.

# Max concurrent packet dispatches (default: 5). Positive integer only.
# O8_MAX_PARALLEL_DISPATCHES=5

# Overlap gate mode: 0 = advisory (default), 1 = strict.
# O8_STRICT_OVERLAP_GATE=0

# Gate the heal-bot worker in ws-server.ts: 0/1 (default: 1).
# O8_HEAL_BOT_ENABLED=1

# Inject supervisor failures back into the orchestrator chat: 0/1 (default: 0).
# O8_SUPERVISOR_AUTO_ESCALATE=0

# Default thinking effort for new orchestrator threads:
# adaptive | low | medium | high | max | xhigh (default: adaptive).
# O8_THINKING_EFFORT=adaptive

# Gate Anthropic cache_control injection in /api/v2/proxy/llm: 0/1 (default: 1).
# O8_PROMPT_CACHING=1

# Default orchestrator model for new threads. Built-in options include
# claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-sonnet-4-5,
# and claude-haiku-4-5 (default: claude-opus-4-7).
# O8_ORCHESTRATOR_MODEL=claude-opus-4-7

# ─── Entitlement / licensing ──────────────────────────────────────────

# Plan override for local testing of Pro-gated features: free | pro.
# O8_PLAN=

# License-verifier public key override (dev/testing only; the production
# key is compiled into the app).
# O8_LICENSE_PUBKEY=

# Require BYOK keys for LLM features (Q&A cascade): 0/1.
# O8_BYOK_REQUIRED=

# ─── Experimental runtimes / dispatch ─────────────────────────────────

# Surface experimental runtime adapters in the dispatch picker: 0/1.
# O8_EXPERIMENTAL_GEMINI=
# O8_EXPERIMENTAL_OPENCODE=

# Default dispatch runtime when a packet doesn't specify one.
# O8_DEFAULT_DISPATCH_RUNTIME=codex

# ─── Tauri packaging ──────────────────────────────────────────────────

# Signals the packaged app is running and tells Next where the bundled
# MCP scripts live. These are set automatically by the Rust sidecar —
# don't set them manually unless you know what you're doing.
# O8_NODE_BIN=
# O8_BUNDLED_MCP_DIR=
# O8_BUNDLED_MCP_PATH=
# O8_TAURI_MCP_SOCKET=

# ─── Deployments (optional) ───────────────────────────────────────────

# Vercel token for the deploys panel.
# VERCEL_TOKEN=

# Public base URL (for OAuth callbacks, webhook URLs, etc.).
# CORTEX_IDE_PUBLIC_BASE_URL=http://localhost:3001

# ─── Build-time (read by postinstall / scripts) ───────────────────────

# Git commit SHA — set by CI, used in the About panel.
# GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_REPO_URL=https://github.com/hurttlocker/cortex-ide
