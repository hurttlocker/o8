<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>o8 uses your microphone for push-to-talk voice dictation.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>o8 uses Apple Speech Recognition to turn your voice into text before polish runs.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>o8 uses Accessibility to capture the global Fn hotkey and paste dictated text into the app you are working in.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>o8 uses Automation to restore focus after a voice action completes.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Symon reads your calendar to answer "what's on my calendar" by voice.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Symon reads your reminders to answer "what's on my list" by voice.</string>
    <!-- App Transport Security: the embedded native browser-view (a host-owned
         child WebviewWindow) loads arbitrary HTTPS sites (Clerk auth apps, etc.).
         Its in-page agent must POST grab/read/click results back to the local o8
         server at http://127.0.0.1:<port>/api/browser/native-result. ATS blocks
         HTTP requests made from an HTTPS page by default ("TypeError: Load failed"),
         which kills the result channel on every real (HTTPS) site. Scope the
         exception to web-content + local networking so ATS stays in force for the
         rest of the app's network calls. (127.0.0.1/localhost are already exempt
         from the web-platform mixed-content algorithm; this lifts only the ATS
         network-layer block.) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Register o8 in Finder's "Open With" for any file. Role Viewer + rank
         Alternate = o8 is LISTED in the Open With submenu but never claims the
         default handler for any type (the two together are what keep o8 from
         stealing another app's default). The UTI set is a deliberate catch-all:
         public.data conforms every file (incl. extensionless); public.text +
         public.source-code + public.plain-text name the dev-file surface o8
         actually opens. NOTE: this is authored HERE rather than as
         `bundle.fileAssociations` in tauri.conf.json on purpose — Tauri's
         fileAssociations can only enumerate extensions (no UTI catch-all, no
         LSHandlerRank), and Tauri merges this custom Info.plist OVER its
         generated CFBundleDocumentTypes, so a tauri.conf entry would be dead
         config. Opens are delivered via RunEvent::Opened in lib.rs → the
         dashboard workspace (default) or the canvas as file cards. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Any document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.data</string>
                <string>public.text</string>
                <string>public.source-code</string>
                <string>public.plain-text</string>
                <!-- Explicit UTIs: LaunchServices does NOT reliably surface
                     Open With entries via public.data conformance alone —
                     PNG/HTML were missing from the menu (operator 2026-07-09)
                     despite the catch-all above. Images render via the file
                     card / ImagePreview; HTML via HtmlPreview. -->
                <string>public.image</string>
                <string>public.html</string>
                <string>public.xml</string>
                <string>public.json</string>
                <string>public.yaml</string>
                <string>com.netscape.javascript-source</string>
            </array>
        </dict>
    </array>
    <!-- Custom URL scheme o8:// for the Clerk auth deep-link handoff
         (o8://auth/callback?ticket=...&state=...). macOS LaunchServices routes
         it to the running app → RunEvent::Opened in lib.rs. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>ai.o8.desktop.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>o8</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
