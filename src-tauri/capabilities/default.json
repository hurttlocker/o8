{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Cortex IDE default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "shell:allow-open",
    "shell:allow-execute",
    "process:default",
    "notification:default",
    "store:default",
    "log:default"
  ]
}
