# ─────────────────────────────────────────────────────────────────────────────
# o8 license server — environment
# Copy to .env for local dev. Set the same vars in Railway for production.
# NO real secrets in this file — placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (Dashboard -> Developers -> Webhooks -> your endpoint)
# The endpoint URL is https://<your-railway-url>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (Dashboard -> Products). Map prices to plans:
#   STRIPE_PRICE_SOLO -> 'pro'  ($19/mo solo Pro)
#   STRIPE_PRICE_TEAM -> 'team' ($29/seat/mo team)
STRIPE_PRICE_SOLO=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TEAM=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Ed25519 PRIVATE signing key (PKCS8 PEM). Generate with: npm run gen-keys
# Paste the matching PUBLIC key into the desktop app's
# src/lib/entitlement/license.ts (PLACEHOLDER_DEV_PUBLIC_KEY_PEM).
# In Railway, paste the multi-line PEM directly. For a .env file you may also use
# literal \n escapes — env.ts normalizes them back to newlines.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----"

# Postgres connection string (Railway provisions this automatically as DATABASE_URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT issuer claim baked into every minted license (must be stable)
ISSUER=o8-license

# Guards the manual /issue-entitlement and /revoke/:id admin endpoints.
# Use a long random string (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=replace-with-a-long-random-string

# Guards POST /invites/register (the desktop app sends this when it shares a
# beta invite). Optional — leave unset to disable invite registration entirely.
# Use a long random string; rotate independently of ADMIN_TOKEN.
INVITE_REGISTER_TOKEN=replace-with-a-long-random-string

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Clerk issuer URL (e.g. https://<slug>.clerk.accounts.dev, or your prod issuer).
# Verifies a desktop's Clerk session token on POST /account/license so a signed-in
# user can pull THEIR OWN license — no shared secret shipped in the app. Optional:
# when unset, /account/license returns 503 (feature off).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Clerk Backend API secret key (sk_...). Used ONLY to resolve a Clerk user's
# GitHub external account (users.getUser → externalAccounts) so an entitlement can
# key on the STABLE GitHub identity, not just the exact Clerk user id in Stripe
# metadata (#1519). Powers: best-effort githubAccountId backfill at
# checkout/account-fetch, the /account/license GitHub fallback + clerkUserId
# migration, and POST /admin/backfill-github. Optional — when unset the server
# behaves exactly as before (no backfill, no fallback; the direct clerkUserId
# lookup is unaffected). NEVER shipped in the desktop build.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Exact browser origins permitted by the Clerk session token's `azp` claim.
# Native o8 desktop tokens use Authorization without Origin and legitimately
# omit `azp`; signature + issuer + expiry still authenticate those tokens.
CLERK_AUTHORIZED_PARTIES=https://o8.run

# ── Managed GitHub App ────────────────────────────────────────────────────────
# Public App identity used to mint one-hour installation tokens for signed-in
# desktops. The private key stays on the license server and never ships in o8.
GITHUB_APP_ID=1234567
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...replace-me...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_SLUG=o8-run

# HTTP port (Railway sets PORT automatically; 8080 is the local default)
PORT=8080
