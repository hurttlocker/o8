# ─────────────────────────────────────────────────────────────────────────────
# o8 relay — environment
# Copy to .env for local dev. Set the same vars in Railway for production.
# NO real secrets in this file — placeholders only.
# The relay holds NO database, session keys, prompt content, or license private
# key. It verifies signed plan/machine JWTs, calls the license server for
# account-scoped ownership and heartbeats, and transiently sends APNs pushes.
# Frame bodies are never read.
# ─────────────────────────────────────────────────────────────────────────────

# Ed25519 PUBLIC key (SPKI PEM) matching the license server's LICENSE_PRIVATE_KEY.
# This VERIFIES the plan-JWT the Mac connector presents — the relay never signs.
# Get it from the license server: `npm run gen-keys` prints the PUBLIC block, or
# derive it from the existing private key. In Railway paste the multi-line PEM
# directly; a .env file may use literal \n escapes (normalized back to newlines).
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...replace-me...\n-----END PUBLIC KEY-----"

# JWT issuer claim to require on every presented plan-JWT. MUST match the license
# server's ISSUER. Leave as the default unless you changed it there.
ISSUER=o8-license

# Existing license-server base. The relay uses it to validate web ownership and
# to emit server-derived machine heartbeats. Defaults to the production service.
LICENSE_SERVER_BASE_URL=https://o8-license-server-production.up.railway.app

# ── APNs (queue-and-notify) — OPTIONAL ───────────────────────────────────────
# When unset, `push-req` control frames are logged and dropped (no push). Set all
# three to enable the "o8 needs you — approval waiting" generic ALERT push.
# These deliver to a REAL remote-notification device token (apns-push-type: alert)
# that the Mac holds from the phone's registerForRemoteNotifications — NOT the
# ActivityKit token. The token is used transiently per request and never stored.
#
# The .p8 signing key CONTENTS (PKCS8 PEM). In Railway paste the multi-line PEM;
# a .env file may use literal \n escapes.
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----"
# The 10-char Key ID from the Apple Developer key page.
APNS_KEY_ID=XXXXXXXXXX
# Your 10-char Apple Developer Team ID.
APNS_TEAM_ID=YYYYYYYYYY
# APNs topic = the iOS app bundle id.
APNS_BUNDLE_ID=com.marquisehurtt.o8mobile
# APNS_ENV is only a FALLBACK default — the live environment is carried per
# `push-req` and sendApprovalAlert() selects the APNs host from it, so you do not
# normally set this. Local development builds → sandbox; TestFlight AND App Store
# → production (TestFlight uses PRODUCTION APNs, NOT sandbox). Leave unset in prod.
# APNS_ENV=production

# ── Tuning (all optional; sane defaults baked in) ────────────────────────────
# Max logical in-tunnel response the relay will relay before a 413 (bytes). The
# connector chunks large responses; this is the hard ceiling. Default 32MB.
RELAY_MAX_TUNNEL_BYTES=33554432

# HTTP/WS port (Railway sets PORT automatically; 8080 is the local default).
PORT=8080
