{
  "name": "o8",
  "version": "0.1.605",
  "description": "o8 — governance layer for autonomous engineering teams. Approvals, audit, organizational memory.",
  "productName": "o8",
  "private": true,
  "main": "src/app/layout.tsx",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "predev:cleanup": "node scripts/dev.mjs cleanup",
    "dev": "node scripts/dev.mjs all",
    "dev:next": "node scripts/dev.mjs next",
    "dev:ws": "node scripts/dev.mjs ws",
    "dev:all": "node scripts/dev.mjs all",
    "build": "sh -c 'node scripts/bust-stale-patch-cache.mjs && env -u TURBOPACK -u NEXT_DEPLOYMENT_ID -u __NEXT_PRIVATE_ORIGIN -u __NEXT_PRIVATE_STANDALONE_CONFIG NODE_ENV=production NODE_OPTIONS=--max-old-space-size=24576 next build --webpack'",
    "start": "sh -c 'next start -p \"${PORT:-3001}\"'",
    "lint": "eslint .",
    "typecheck": "rm -rf .next/types .next/dev/types && next typegen && tsc --noEmit",
    "rule-check": "tsx scripts/rule-check.ts",
    "eval:qa": "tsx src/lib/cortex/qa/eval/runner.ts",
    "smoke:qa": "NODE_OPTIONS=\"--import=./scripts/register-server-only-stub.mjs\" tsx tests/qa-eval/smoke.ts",
    "validate:qa-cases": "tsx scripts/validate-qa-cases.ts",
    "smoke": "node scripts/smoke.mjs",
    "seed:demo": "node scripts/seed-demo-state.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:dev": "tsx scripts/worker/index.ts",
    "research:session": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 1",
    "research:session:2": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 2",
    "research:session:3": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 3",
    "research:daily": "tsx scripts/research/run-cortex-autoresearch.ts --trigger daily --max-loops 1",
    "research:post-merge": "tsx scripts/research/run-cortex-autoresearch.ts --trigger post-merge --max-loops 1",
    "reports": "node scripts/reports.mjs",
    "publish:fixed": "node scripts/publish-fixed.mjs",
    "sync:reports": "node scripts/sync-reports.mjs",
    "measure:render": "bash scripts/measure-render-speed.sh",
    "measure:cli": "bash scripts/measure-cli.sh",
    "measure:socket": "bash scripts/measure-socket.sh",
    "measure:mcp": "bash scripts/measure-mcp.sh",
    "bench:speed": "node scripts/bench/run-speed.mjs",
    "bench:memory": "node scripts/bench/run-memory.mjs",
    "bench:score": "node scripts/bench/score.mjs",
    "bench:all": "npm run bench:speed && npm run bench:memory && npm run bench:score",
    "desktop:dev": "npm run dev",
    "predev:cleanup:side": "lsof -ti :3010 -sTCP:LISTEN | xargs kill -9 2>/dev/null; lsof -ti :3011 -sTCP:LISTEN | xargs kill -9 2>/dev/null; true",
    "dev:side": "PORT=3010 O8_API_PORT=3010 O8_WS_PORT=3011 next dev -p 3010",
    "dev:ws:side": "PORT=3010 O8_API_PORT=3010 O8_WS_PORT=3011 WS_PORT=3011 NODE_OPTIONS=\"--import=./scripts/register-server-only-stub.mjs\" tsx src/ws-server.ts",
    "desktop:dev:side": "npm run predev:cleanup:side && concurrently -k -s first \"npm run dev:side\" \"npm run dev:ws:side\"",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3001",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "tauri:build:signed": "sh -c 'TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/cortex-ide.key) TAURI_SIGNING_PRIVATE_KEY_PASSWORD= cargo tauri build -- --features dev-mcp-plugin'",
    "gate:webview": "node scripts/preship-webview-gate.mjs",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/detach-stale-dmg.mjs && npm run tauri:build:nonotary && npm run sign-and-notarize && npm run release && node scripts/detach-stale-dmg.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "tauri:prebuild": "node scripts/preship-cleanup.mjs && node scripts/build-speech-local.mjs && npm run build && node scripts/tauri-export.mjs",
    "version": "node scripts/sync-version.mjs",
    "tauri:build:nonotary": "sh -c 'unset APPLE_ID APPLE_PASSWORD APPLE_TEAM_ID; TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/cortex-ide.key) TAURI_SIGNING_PRIVATE_KEY_PASSWORD= cargo tauri build -- --features dev-mcp-plugin'",
    "sign-and-notarize": "node scripts/sign-and-notarize.mjs",
    "build:cli": "node cli/esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dogfood:symon-localization": "node scripts/watch-symon-localization.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.109",
    "@assistant-ui/react": "^0.12.22",
    "@chenglou/pretext": "^0.0.8",
    "@clerk/nextjs": "^7.3.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@json-render/core": "^0.14.0",
    "@json-render/react": "^0.14.0",
    "@json-render/shadcn": "^0.14.0",
    "@lezer/highlight": "^1.2.3",
    "@lisse/core": "^0.4.0",
    "@lisse/react": "^0.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/browser": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/api": "~2.10.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.36.0",
    "iconoir-react": "^7.11.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.2.10",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "tauri-plugin-clerk": "^0.1.1",
    "tauri-plugin-mcp": "^0.1.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "node-pty": "^1.2.0-beta.12",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "esbuild": "0.28.1",
    "postcss": "8.5.19",
    "uuid": "11.1.1"
  }
}
