{
  "name": "cortex-ide",
  "version": "0.1.0",
  "productName": "Cortex IDE",
  "private": true,
  "main": "src/app/layout.tsx",
  "scripts": {
    "predev:cleanup": "lsof -ti :3001 -sTCP:LISTEN | xargs kill -9 2>/dev/null; lsof -ti :3002 -sTCP:LISTEN | xargs kill -9 2>/dev/null; true",
    "dev": "next dev -p 3001",
    "dev:ws": "tsx src/ws-server.ts",
    "dev:all": "npm run dev & npm run dev:ws &",
    "build": "next build",
    "start": "sh -c 'next start -p \"${PORT:-3001}\"'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "research:session": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 1",
    "research:session:2": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 2",
    "research:session:3": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 3",
    "research:daily": "tsx scripts/research/run-cortex-autoresearch.ts --trigger daily --max-loops 1",
    "research:post-merge": "tsx scripts/research/run-cortex-autoresearch.ts --trigger post-merge --max-loops 1",
    "measure:render": "bash scripts/measure-render-speed.sh",
    "desktop:dev": "npm run predev:cleanup && concurrently -k -s first \"npm run dev\" \"npm run dev:ws\"",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "postinstall": "npx node-gyp rebuild --directory=node_modules/node-pty 2>/dev/null || true",
    "tauri:prebuild": "next build && node scripts/tauri-export.mjs"
  },
  "dependencies": {
    "@json-render/core": "^0.14.0",
    "@json-render/react": "^0.14.0",
    "@json-render/shadcn": "^0.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.36.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.22.0",
    "eslint-config-next": "^16.1.6",
    "node-pty": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.2"
  }
}
