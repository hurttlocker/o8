{
  "name": "cortex-ide",
  "version": "0.0.1",
  "productName": "Cortex IDE",
  "private": true,
  "main": "src/app/layout.tsx",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:ws": "tsx src/ws-server.ts",
    "dev:all": "npm run dev & npm run dev:ws &",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "concurrently -k -s first \"npm run dev\" \"npm run dev:ws\""
  },
  "dependencies": {
    "@json-render/core": "^0.14.0",
    "@json-render/react": "^0.14.0",
    "@json-render/shadcn": "^0.14.0",
    "@tanstack/react-virtual": "^3.13.22",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "9.22.0",
    "eslint-config-next": "^16.1.6",
    "tsx": "^4.21.0",
    "typescript": "5.8.2"
  }
}
