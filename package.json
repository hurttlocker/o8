{
  "name": "o8",
  "version": "0.1.726",
  "description": "o8 — governance layer for autonomous engineering teams. Approvals, audit, organizational memory.",
  "license": "MIT",
  "productName": "o8",
  "private": true,
  "main": "src/app/layout.tsx",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "predev:cleanup": "node scripts/dev.mjs cleanup",
    "dev": "node scripts/dev.mjs all",
    "dev:next": "node scripts/dev.mjs next",
    "dev:ws": "node scripts/dev.mjs ws",
    "dev:all": "node scripts/dev.mjs all",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 54",
    "typecheck": "npm run verify:routes && node scripts/typecheck.mjs",
    "verify:routes": "vitest run tests/route-coverage.test.ts -t \"route module shape\"",
    "rule-check": "tsx scripts/rule-check.ts",
    "eval:qa": "tsx src/lib/cortex/qa/eval/runner.ts",
    "smoke:qa": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx tests/qa-eval/smoke.ts",
    "validate:qa-cases": "tsx scripts/validate-qa-cases.ts",
    "smoke": "node scripts/smoke.mjs",
    "seed:demo": "node scripts/seed-demo-state.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:dev": "tsx scripts/worker/index.ts",
    "research:session": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 1",
    "research:session:2": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 2",
    "research:session:3": "tsx scripts/research/run-cortex-autoresearch.ts --trigger on-demand --max-loops 3",
    "research:daily": "tsx scripts/research/run-cortex-autoresearch.ts --trigger daily --max-loops 1",
    "research:post-merge": "tsx scripts/research/run-cortex-autoresearch.ts --trigger post-merge --max-loops 1",
    "reports": "node scripts/reports.mjs",
    "downloads": "node scripts/downloads.mjs",
    "publish:fixed": "node scripts/publish-fixed.mjs",
    "sync:reports": "node scripts/sync-reports.mjs",
    "measure:render": "bash scripts/measure-render-speed.sh",
    "measure:cli": "bash scripts/measure-cli.sh",
    "measure:socket": "bash scripts/measure-socket.sh",
    "measure:mcp": "bash scripts/measure-mcp.sh",
    "bench:speed": "node scripts/bench/run-speed.mjs",
    "bench:quick": "node scripts/bench/quick.mjs",
    "bench:memory": "node scripts/bench/run-memory.mjs",
    "bench:terminal": "node scripts/bench/run-terminal-workload.mjs",
    "bench:terminal:check": "node scripts/bench/run-terminal-workload.mjs --check",
    "bench:governance": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-governance.ts && npm run bench:score",
    "bench:score": "node scripts/bench/score.mjs",
    "bench:all": "npm run bench:speed && npm run bench:memory && npm run bench:governance",
    "desktop:dev": "npm run dev",
    "predev:cleanup:side": "node scripts/kill-port.mjs 3010 3011",
    "dev:side": "node scripts/run.mjs PORT=3010 O8_API_PORT=3010 O8_WS_PORT=3011 -- next dev -p 3010",
    "dev:ws:side": "node scripts/run.mjs PORT=3010 O8_API_PORT=3010 O8_WS_PORT=3011 WS_PORT=3011 NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx src/ws-server.ts",
    "desktop:dev:side": "npm run predev:cleanup:side && concurrently -k -s first \"npm run dev:side\" \"npm run dev:ws:side\"",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3001",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:signed": "sh -c 'TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/cortex-ide.key) TAURI_SIGNING_PRIVATE_KEY_PASSWORD= node scripts/tauri-build.mjs -- --features dev-mcp-plugin'",
    "gate:webview": "node scripts/preship-webview-gate.mjs",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/release.mjs --ship",
    "postinstall": "node scripts/postinstall.mjs",
    "tauri:prebuild": "node scripts/tauri-prebuild.mjs",
    "version": "node scripts/sync-version.mjs",
    "tauri:build:nonotary": "sh -c 'unset APPLE_ID APPLE_PASSWORD APPLE_TEAM_ID; TAURI_SIGNING_PRIVATE_KEY=$(cat ~/.tauri/cortex-ide.key) TAURI_SIGNING_PRIVATE_KEY_PASSWORD= node scripts/tauri-build.mjs -- --features dev-mcp-plugin'",
    "sign-and-notarize": "node scripts/sign-and-notarize.mjs",
    "build:cli": "node cli/esbuild.config.mjs",
    "test": "vitest run --config config/vitest/vitest.unit.config.ts",
    "test:all": "node scripts/test-gates.mjs",
    "test:unit": "vitest run --config config/vitest/vitest.unit.config.ts",
    "test:integration": "node scripts/integration-test-gate.mjs",
    "test:classify": "node scripts/classify-tests.mjs --write",
    "test:classification:check": "node scripts/classify-tests.mjs --check",
    "test:watch": "vitest",
    "protocol:generate": "node scripts/generate-realtime-protocol.mjs",
    "protocol:check": "node scripts/generate-realtime-protocol.mjs --check",
    "dogfood:symon-localization": "node scripts/watch-symon-localization.mjs",
    "bench:coding": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --preflight",
    "bench:coding:collect": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --collect",
    "bench:coding:judge": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --judge",
    "bench:coding:all": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --all",
    "bench:coding:e2e:preflight": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --preflight --e2e",
    "bench:coding:e2e": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --e2e",
    "bench:coding:e2e:judge": "node scripts/run.mjs NODE_OPTIONS=--import=./scripts/register-server-only-stub.mjs -- tsx scripts/bench/run-coding.ts --e2e-judge"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.109",
    "@assistant-ui/react": "^0.12.22",
    "@chenglou/pretext": "^0.0.8",
    "@clerk/nextjs": "^7.3.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@json-render/core": "^0.14.0",
    "@json-render/react": "^0.14.0",
    "@json-render/shadcn": "^0.14.0",
    "@lezer/highlight": "^1.2.3",
    "@lisse/core": "^0.4.0",
    "@lisse/react": "^0.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/browser": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.6.0",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.36.0",
    "iconoir-react": "^7.11.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "mermaid": "^11.16.1",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.2.11",
    "playwright-core": "^1.60.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "smol-toml": "^1.7.1",
    "tauri-plugin-clerk": "^0.1.1",
    "tauri-plugin-mcp": "^0.1.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "^8.18.1",
    "@xterm/headless": "5.5.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "node-gyp": "13.0.1",
    "node-pty": "^1.2.0-beta.12",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "esbuild": "0.28.1",
    "postcss": "8.5.26",
    "uuid": "11.1.1",
    "sharp": "0.35.0"
  }
}
