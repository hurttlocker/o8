{
  "name": "cortex-ide",
  "version": "0.0.1",
  "productName": "Cortex IDE",
  "private": true,
  "main": "src/app/layout.tsx",
  "scripts": {
    "predev:cleanup": "lsof -ti :3001 -sTCP:LISTEN | xargs kill -9 2>/dev/null; lsof -ti :3002 -sTCP:LISTEN | xargs kill -9 2>/dev/null; true",
    "dev": "next dev -p 3001",
    "dev:ws": "tsx src/ws-server.ts",
    "dev:all": "npm run dev & npm run dev:ws &",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run predev:cleanup && concurrently -k -s first \"npm run dev\" \"npm run dev:ws\"",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "postinstall": "npx node-gyp rebuild --directory=node_modules/node-pty 2>/dev/null || true"
  },
  "dependencies": {
    "@json-render/core": "^0.14.0",
    "@json-render/react": "^0.14.0",
    "@json-render/shadcn": "^0.14.0",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "9.22.0",
    "eslint-config-next": "^16.1.6",
    "node-pty": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.2"
  }
}
