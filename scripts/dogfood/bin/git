#!/bin/bash
# Git entrypoint injected into every dogfood-loop descendant. The pre-push hook
# performs the ref-level decision; this shim also forbids --no-verify so the
# hook cannot be skipped accidentally.
set -euo pipefail

: "${O8_DOGFOOD_GUARDED:?dogfood Git shim requires the guarded launcher}"
: "${O8_DOGFOOD_REAL_GIT:?dogfood Git shim is missing the real Git path}"
: "${O8_DOGFOOD_HOOKS_DIR:?dogfood Git shim is missing its hooks directory}"

is_push=0
skip_hooks=0
for arg in "$@"; do
  [ "$arg" = 'push' ] && is_push=1
  case "$arg" in
    --no-verify|-n) skip_hooks=1 ;;
  esac
done

if [ "$is_push" -eq 1 ] && [ "$skip_hooks" -eq 1 ]; then
  echo 'o8 dogfood guard: git push --no-verify is disabled while the PR-only loop is active.' >&2
  exit 64
fi

exec "$O8_DOGFOOD_REAL_GIT" -c "core.hooksPath=$O8_DOGFOOD_HOOKS_DIR" "$@"
