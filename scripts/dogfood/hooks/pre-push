#!/bin/bash
# Ref-level backstop for every Git process descended from the dogfood wrapper.
# Git has already resolved implicit refspecs when this hook receives them, so
# this catches `push`, `push origin main`, `HEAD:main`, `--all`, and deletion.
set -euo pipefail

while read -r local_ref local_oid remote_ref remote_oid; do
  : "${local_ref:=}"
  : "${local_oid:=}"
  : "${remote_oid:=}"
  if [ "$remote_ref" = 'refs/heads/main' ]; then
    echo 'o8 dogfood guard: pushes to refs/heads/main are blocked; open a pull request.' >&2
    exit 65
  fi
done

exit 0
