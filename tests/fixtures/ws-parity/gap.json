{
  "name": "stale epoch forces authoritative session checkpoint",
  "actions": [
    {
      "op": "http",
      "target": "fixture",
      "path": "/fixture/history",
      "body": {
        "version": 0
      },
      "status": 200
    },
    {
      "op": "connect",
      "client": "a"
    },
    {
      "op": "receive",
      "client": "a",
      "entries": [
        {
          "kind": "message",
          "frame": {
            "channel": "system",
            "event": "connected",
            "data": {
              "clientId": {
                "$capture": "aId",
                "type": "string"
              },
              "gateway": "disabled",
              "realtimeSeq": {
                "$capture": "aSeq",
                "type": "number"
              },
              "instanceId": {
                "$capture": "instanceId",
                "type": "string"
              },
              "bootId": {
                "$capture": "bootId",
                "type": "string"
              }
            }
          }
        },
        {
          "kind": "message",
          "frame": {
            "channel": "orchestrator-threads",
            "event": "snapshot",
            "data": {
              "threads": []
            }
          }
        },
        {
          "kind": "message",
          "frame": {
            "channel": "inbox",
            "event": "update",
            "data": {
              "generatedAt": "2026-01-01T00:00:00.000Z",
              "mode": "live",
              "sourceLabel": "o8",
              "sessions": [],
              "fleetSessions": [],
              "approvals": [],
              "reviewUnits": [],
              "items": [],
              "summary": {}
            }
          }
        }
      ]
    },
    {
      "op": "send",
      "client": "a",
      "frame": {
        "type": "realtime-negotiate",
        "protocol": {
          "min": 1,
          "max": 1
        },
        "appVersion": "1.0.0",
        "clientKind": "test",
        "capabilities": [
          "mobile-inbox-delta-v1"
        ]
      }
    },
    {
      "op": "receive",
      "client": "a",
      "entries": [
        {
          "kind": "message",
          "frame": {
            "channel": "realtime",
            "event": "welcome",
            "data": {
              "protocol": 1,
              "serverVersion": {
                "$capture": "serverVersion",
                "type": "string"
              },
              "epoch": {
                "$capture": "epoch",
                "type": "string"
              },
              "features": [
                "mobile-inbox-delta-v1"
              ],
              "legacyFallback": {
                "supported": true,
                "protocol": 1,
                "removalDate": "2027-08-12",
                "removalProtocol": 2
              }
            }
          }
        }
      ]
    },
    {
      "op": "send",
      "client": "a",
      "frame": {
        "type": "realtime-subscribe",
        "subscriptions": [
          {
            "stream": "session:gap-fixture",
            "epoch": "retired-epoch",
            "since": 999999
          }
        ]
      }
    },
    {
      "op": "receive",
      "client": "a",
      "entries": [
        {
          "kind": "message",
          "frame": {
            "channel": "realtime",
            "event": "batch",
            "data": {
              "delivery": "bootstrap",
              "stream": "session:gap-fixture",
              "events": [
                {
                  "protocol": 1,
                  "seq": {
                    "$capture": "checkpointSeq",
                    "type": "number"
                  },
                  "stream": "session:gap-fixture",
                  "channel": "history",
                  "event": "history.snapshot",
                  "ts": {
                    "$capture": "checkpointTime",
                    "type": "string"
                  },
                  "snapshot": true,
                  "entityId": "gap-fixture",
                  "health": {
                    "state": "degraded",
                    "reason": "Replay gap detected; forcing fresh session resync."
                  },
                  "capturedSeq": {
                    "$ref": "checkpointSeq",
                    "add": -1
                  },
                  "data": {
                    "sessionKey": "gap-fixture",
                    "entries": [
                      {
                        "id": "history-0",
                        "role": "assistant",
                        "text": "history 0"
                      }
                    ],
                    "replace": true
                  }
                }
              ],
              "epoch": {
                "$ref": "epoch"
              },
              "latestSeq": {
                "$ref": "checkpointSeq"
              },
              "gap": {
                "requestedSince": 999999,
                "earliestAvailable": {
                  "$ref": "checkpointSeq",
                  "add": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "op": "close",
      "client": "a",
      "code": 1000,
      "reason": "done"
    },
    {
      "op": "receive",
      "client": "a",
      "entries": [
        {
          "kind": "close",
          "code": 1000,
          "reason": "done"
        }
      ]
    }
  ]
}
