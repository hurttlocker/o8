diff --git a/src/reservation-store.ts b/src/reservation-store.ts
--- a/src/reservation-store.ts
+++ b/src/reservation-store.ts
@@ -6,5 +6,6 @@ export type PersistReservation = (reservation: Reservation) => Promise<void>;
 
 const activeReservations = new Set<string>();
+const pendingReservations = new Map<string, Promise<boolean>>();
 
 function reservationKey(reservation: Reservation): string {
   return `${reservation.repositoryId}:${reservation.requestId}`;
@@ -15,7 +16,20 @@ export async function reserve(
   reservation: Reservation,
   persist: PersistReservation,
 ): Promise<boolean> {
-  await persist(reservation);
-  activeReservations.add(reservationKey(reservation));
-  return true;
+  const key = reservationKey(reservation);
+  if (activeReservations.has(key)) return false;
+
+  const pending = pendingReservations.get(key);
+  if (pending) return pending;
+
+  const operation = persist(reservation)
+    .then(() => {
+      activeReservations.add(key);
+      return true;
+    })
+    .finally(() => {
+      pendingReservations.delete(key);
+    });
+  pendingReservations.set(key, operation);
+  return operation;
 }
